function zsh_add_file() {
    [ -f "$ZDOTDIR/$1" ] && source "$ZDOTDIR/$1"
}

function zsh_add_plugin() {
    PLUGIN_NAME=$(echo $1 | cut -d "/" -f 2)
    if [ -d "$ZDOTDIR/plugins/$PLUGIN_NAME" ]; then
        # For plugins
        zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.plugin.zsh" || \
        zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.zsh"
    else
        git clone "https://github.com/$1.git" "$ZDOTDIR/plugins/$PLUGIN_NAME" && zsh_add_plugin "$1"
    fi
}

function fds() {
  preview="git diff $@ --color=always {1} | delta "
  git diff $@ --name-only | fzf --header "Changed files" --preview $preview | pbcopy
}

function gb() {
  git branch --sort=-committerdate | fzf --header "Checkout Recent Branch" --preview "git diff --color=always {1} | delta" --pointer="" | xargs git checkout
}

# wt - pick a git worktree of this repo with fzf and cd into it.
# The preview shows the worktree's status and its last commits.
function wt() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "wt: not in a git repo" >&2; return 1; }

  local here=$(git rev-parse --show-toplevel)
  local line dir= branch= mark rows=()
  while IFS= read -r line; do
    case $line in
      worktree\ *) dir=${line#worktree } branch="(detached)" ;;
      branch\ *) branch=${line#branch refs/heads/} ;;
      bare) branch="(bare)" ;;
      "")
        if [[ -n $dir ]]; then
          mark=""
          [[ $dir == $here ]] && mark="(here)"
          rows+=("$branch"$'\t'"$dir"$'\t'"$mark")
        fi
        dir=
        ;;
    esac
  done < <(git worktree list --porcelain; echo)

  local pick=$(printf '%s\n' "${rows[@]}" | fzf --header "Worktrees: Enter goes to the folder" \
    --delimiter $'\t' --preview 'git -C {2} -c color.status=always status -sb; echo; git -C {2} log --oneline --color=always -15' \
    --pointer="" --no-sort)
  [[ -n $pick ]] || return 0
  cd "${${pick#*$'\t'}%%$'\t'*}"
}

