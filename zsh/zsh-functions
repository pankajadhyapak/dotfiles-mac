# t - smart tmux session manager
#
#   t       open the session for the current directory
#   t -     pick a directory from zoxide with fzf, then open its session
#   tm      same as `t -`
#
# A session is named after the directory's basename, with spaces, dots, colons
# and hyphens replaced by underscores (tmux does not accept . or : in names).
# If the session does not exist, it is created in that directory.
# Outside tmux it attaches; inside tmux it switches the client (attach-session
# refuses to run inside tmux).
function t(){
  local dir="$PWD"
  if [[ $1 == - ]]; then
    dir=$(zoxide query --list | fzf --prompt 'tmux> ') || return # Esc: do nothing
    [[ -n $dir ]] || return
  elif [[ -n $1 ]]; then
    echo "usage: t [-]" >&2
    return 1
  fi

  local name=${${dir:t}//[ .:-]/_}
  # "=" makes tmux match the exact name, not a session that only starts with it.
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$dir" || return
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach-session -t "=$name"
  fi
}
alias tm='t -'

# b2m - back to main: stash local changes, switch to the default branch of
# origin (main or master) and pull it. `git stash pop` brings the changes back.
function b2m() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "b2m: not in a git repo" >&2; return 1; }

  local main=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  main=${main#origin/}
  [[ -n $main ]] || main=main

  # Another worktree can hold the branch; git cannot check it out twice.
  local holder=$(git worktree list --porcelain | awk -v b="branch refs/heads/$main" '/^worktree /{p=substr($0,10)} $0==b{print p}')
  if [[ -n $holder && $holder != $(git rev-parse --show-toplevel) ]]; then
    echo "b2m: $main is checked out in $holder" >&2
    echo "     Run: cd $holder && b2m" >&2
    return 1
  fi

  if [[ -n $(git status --porcelain) ]]; then
    local from=$(git branch --show-current)
    git stash push -u -m "b2m: from ${from:-detached HEAD} $(date '+%F %T')" || return 1
    echo "b2m: stashed your changes. Run 'git stash pop' to get them back."
  fi

  git fetch origin || return 1
  git switch "$main" || return 1
  git pull --ff-only origin "$main"
}
