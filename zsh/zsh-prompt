#!/bin/zsh

## autoload vcs
autoload -Uz vcs_info
autoload -U add-zsh-hook

# enable only git
zstyle ':vcs_info:*' enable git


prompt_precmd() {
	# shows the full path in the title
	print -Pn '\e]0;%~\a'
}

prompt_preexec() {
	cmd_timestamp=$EPOCHSECONDS

	# shows the current dir and executed command in the title when a process is active
	print -Pn "\e]0;"
	echo -nE "$PWD:t: $2"
	print -Pn "\a"
}
add-zsh-hook precmd prompt_precmd
add-zsh-hook preexec prompt_preexec

# precmd() { vcs_info }

prompt_git_precmd() {
    vcs_info
    if [[ -n ${vcs_info_msg_0_} ]]; then
        # vcs_info found something (the documentation got that backwards
        # STATUS line taken from https://github.com/robbyrussell/oh-my-zsh/blob/master/lib/git.zsh
        STATUS=$(command git status --porcelain 2> /dev/null | head -n1)
        if [[ -n $STATUS ]]; then
            # PROMPT='%F{7}%3~%f %F{red}${vcs_info_msg_0_} %f%# '
            PROMPT='%F{blue}%1~%F{yellow}${vcs_info_msg_0_} %F{red} %f'

        else
            PROMPT='%F{blue}%1~%F{yellow}${vcs_info_msg_0_} %F{green} %f'
        fi
    else
        # nothing from vcs_info
        PROMPT='%F{blue}%1~%F{yellow}${vcs_info_msg_0_} %F{white} %f'
    fi
}
add-zsh-hook precmd prompt_git_precmd

setopt PROMPT_SUBST
zstyle ':vcs_info:git:*' formats '  %b'
